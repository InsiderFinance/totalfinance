{
  "name": "totalfinance-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "TotalFinance — a TypeScript-native finance, quant, options, technical-analysis, and risk toolkit.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json && tsx tools/assemble-distribution.ts",
    "publication:update": "tsx tools/assemble-distribution.ts --update",
    "clean": "tsc -b tsconfig.build.json --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run --testNamePattern property",
    "test:golden": "vitest run golden",
    "bench": "vitest bench --run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs": "typedoc --options typedoc.json",
    "site:build": "tsx site/build.ts",
    "site:dev": "tsx site/serve.ts",
    "site:typecheck": "tsc --noEmit -p site/tsconfig.json",
    "site:test": "vitest run --config site/vitest.config.ts",
    "site:record-release": "tsx site/record-release.ts",
    "agents:score": "tsx tools/agent-experience/cli.ts tools/agent-experience/corpus.json",
    "api:check": "tsx tools/api-report/run.ts --check",
    "api:update": "tsx tools/api-report/run.ts --write",
    "manifest:update": "tsx tools/manifest/generate.ts",
    "signature:update": "pnpm build && tsx tools/manifest/signature-inventory.ts && prettier --write tools/manifest/public-signatures.json",
    "naming:update": "tsx tools/manifest/naming-inventory.ts && prettier --write tools/manifest/public-naming.json",
    "ci": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm site:typecheck && pnpm build && pnpm site:build && pnpm site:test && pnpm test:coverage && pnpm api:check",
    "contract:update": "tsx tools/manifest/contract-inventory.ts && prettier --write tools/manifest/public-contracts.json",
    "enforcement:update": "tsx tools/manifest/measure-supervisor.ts && prettier --write tools/manifest/public-enforcement.json",
    "validation:update": "tsx tools/manifest/validation-specs.ts && prettier --write \"packages/*/src/generated/validation-specs.ts\"",
    "docs:update": "tsx tools/fields-doc.ts && tsx tools/manifest/docs-inventory.ts && prettier --write tools/manifest/public-docs.json",
    "regen:check": "tsx tools/regen-check.ts",
    "openapi:update": "tsx tools/openapi-gen.ts",
    "bundle:update": "pnpm build && tsx tools/bundle-size-doc.ts",
    "artifacts:update": "tsx tools/api-report/run.ts --write && pnpm signature:update && pnpm naming:update && pnpm contract:update && pnpm enforcement:update && tsx tools/readme-gen.ts && tsx tools/llms-docs.ts && tsx tools/public-reference.ts --typedoc && tsx tools/ta-registry-doc.ts && tsx tools/ta-compatibility-doc.ts && tsx tools/ta-warmup-doc.ts && tsx tools/ta-talib-coverage-doc.ts && pnpm bundle:update && pnpm docs:update && prettier --write tools/manifest/*.json",
    "release:dry-run": "tsx tools/release/dry-run.ts",
    "release:smoke": "tsx tools/release/registry-smoke.ts",
    "release:publish": "tsx tools/release/publish-tarballs.ts",
    "release:promote": "tsx tools/release/promote-tarballs.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@jridgewell/sourcemap-codec": "1.5.5",
    "@changesets/cli": "^2.27.10",
    "@eslint/js": "^9.18.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^22.10.5",
    "@vitest/coverage-istanbul": "3.2.6",
    "esbuild": "^0.25.0",
    "eslint": "^9.18.0",
    "fast-check": "^3.23.0",
    "markdown-it": "14.2.0",
    "prettier": "^3.4.2",
    "rollup": "4.62.2",
    "tsx": "^4.19.2",
    "typedoc": "^0.28.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.0"
  }
}

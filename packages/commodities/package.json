{
  "name": "@totalfinance/commodities",
  "version": "0.1.2",
  "description": "Commodity carry and term structure: cost-of-carry forwards, implied carry inputs, roll yield, and curve analytics",
  "license": "Apache-2.0",
  "keywords": [
    "totalfinance",
    "finance",
    "commodities",
    "futures",
    "cost-of-carry",
    "contango",
    "backwardation",
    "roll-yield",
    "term-structure"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InsiderFinance/totalfinance.git",
    "directory": "packages/commodities"
  },
  "homepage": "https://github.com/InsiderFinance/totalfinance/tree/main/packages/commodities#readme",
  "bugs": "https://github.com/InsiderFinance/totalfinance/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./forwards": {
      "types": "./dist/forwards.d.ts",
      "import": "./dist/forwards.js",
      "default": "./dist/forwards.js"
    },
    "./term-structure": {
      "types": "./dist/term-structure.d.ts",
      "import": "./dist/term-structure.js",
      "default": "./dist/term-structure.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "etc",
    "LICENSE",
    "STABILITY.md",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@totalfinance/core": "workspace:*",
    "@totalfinance/math": "workspace:*",
    "@totalfinance/calendars": "workspace:*"
  },
  "private": true
}

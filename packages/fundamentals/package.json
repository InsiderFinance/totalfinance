{
  "name": "@totalfinance/fundamentals",
  "version": "0.0.1",
  "description": "TotalFinance typed fundamentals: the point-in-time FundamentalPeriod contract, availability rule, and raw data-edge record. Browser-safe.",
  "license": "Apache-2.0",
  "keywords": [
    "totalfinance",
    "finance",
    "fundamentals",
    "point-in-time",
    "fiscal-period",
    "financial-statements"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InsiderFinance/totalfinance.git",
    "directory": "packages/fundamentals"
  },
  "homepage": "https://github.com/InsiderFinance/totalfinance/tree/main/packages/fundamentals#readme",
  "bugs": "https://github.com/InsiderFinance/totalfinance/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./statements": {
      "types": "./dist/statements.d.ts",
      "import": "./dist/statements.js",
      "default": "./dist/statements.js"
    },
    "./ratios": {
      "types": "./dist/ratios.d.ts",
      "import": "./dist/ratios.js",
      "default": "./dist/ratios.js"
    },
    "./scores": {
      "types": "./dist/scores.d.ts",
      "import": "./dist/scores.js",
      "default": "./dist/scores.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "etc",
    "LICENSE",
    "STABILITY.md",
    "!dist/.tsbuildinfo"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@totalfinance/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

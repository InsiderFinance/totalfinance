{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "bash site/vercel.sh install",
  "buildCommand": "bash site/vercel.sh build",
  "outputDirectory": "site/dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/docs/totalfinance/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/docs/totalfinance",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(?<accept>.*text/markdown.*)"
        }
      ],
      "destination": "/index.md"
    },
    {
      "source": "/docs/totalfinance/:route((?:[^/]+/)*[^/.]+)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(?<accept>.*text/markdown.*)"
        }
      ],
      "destination": "/:route.md"
    },
    {
      "source": "/docs/totalfinance/:path*",
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/((?!docs/totalfinance/(?:versions/[^/]+/)?runtime/runner$).*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; object-src 'none'; base-uri 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/docs/totalfinance/(.*)runtime/runner",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'; object-src 'none'; base-uri 'none'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/docs/totalfinance/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/docs/totalfinance/versions/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/docs/totalfinance/(.*)\\.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/docs/totalfinance/(.*)runtime/(.*)\\.js",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/docs/totalfinance",
      "destination": "/docs/totalfinance/start",
      "permanent": false
    }
  ]
}

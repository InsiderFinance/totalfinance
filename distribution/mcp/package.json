{
  "name": "@insiderfinance/totalfinance-mcp",
  "version": "0.1.2",
  "description": "TotalFinance MCP server for AI agents. Read-only by default; explicit capabilities for paper-trading workflows.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src",
    "etc",
    "LICENSE",
    "STABILITY.md"
  ],
  "keywords": [
    "finance",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "options",
    "portfolio"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InsiderFinance/totalfinance.git",
    "directory": "distribution/mcp"
  },
  "homepage": "https://github.com/InsiderFinance/totalfinance#readme",
  "bugs": "https://github.com/InsiderFinance/totalfinance/issues",
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "totalfinance-mcp": "./dist/bin.js"
  },
  "dependencies": {
    "@insiderfinance/totalfinance": "0.1.2",
    "@modelcontextprotocol/sdk": "^1.12.0"
  }
}
